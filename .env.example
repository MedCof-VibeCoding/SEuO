# Required. From MongoDB Atlas: Connect → Drivers → copy connection string.
# Replace <password> and use a database name at the end, e.g. ...mongodb.net/myapp
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE_NAME"
# Se login Google falhar com querySrv ECONNREFUSED (comum no Windows), use a string "Standard" do Atlas:
# MONGODB_URI_STANDARD="mongodb://USER:PASSWORD@host0:27017,host1:27017,host2:27017/DATABASE?ssl=true&authSource=admin&replicaSet=..."

# Optional. Public site URL (browser / OAuth redirects).
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- SendGrid (e-mails transacionais) ---
# SENDGRID_API_KEY=""
# Remetente verificado no SendGrid (Single Sender ou domínio autenticado).
# SENDGRID_FROM_EMAIL="Nao-responda@seuo.com.br"

# --- Google Gemini (análise comparativa SEO) ---
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"

# --- OpenAI (optimize / copy) ---
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"

# --- NextAuth (obrigatório para login/cadastro) ---
# Gere um segredo: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
# Google OAuth + Search Console API (habilitar "Google Search Console API" no Cloud Console)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GSC_USE_MOCK=true  # apenas dev: ignora GSC e usa dados simulados
# GitHub OAuth → Settings → Developer settings → OAuth Apps
# Callback: {NEXTAUTH_URL}/api/auth/callback/github
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# --- SQLite (Drizzle + better-sqlite3) ---
# Caminho do arquivo .db. Se omitido, usa ./data/app.db (criado automaticamente).
# SQLITE_DATABASE_PATH="./data/app.db"
